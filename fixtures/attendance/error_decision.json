      }
    },
    {
      "name": "phần tử rejected mã khác (học sinh không thuộc lớp) thì lô vẫn xong, báo riêng học sinh",
      "results": [
        {
          "result": "applied"
        },
        {
          "result": "rejected",
          "errorCode": "NOT_FOUND"
        }
      ],
      "expected": {
        "verdict": "done",
        "rejectedStudentIds": [
          "s1"
        ]
      }
    },
    {
      "name": "gói chỉ đọc từng phần tử cũng không làm hỏng lô",
      "results": [
        {
          "result": "rejected",
          "errorCode": "READONLY_PLAN_LIMIT"
        }
      ],
      "expected": {
        "verdict": "done",
        "rejectedStudentIds": [
          "s0"
        ]
      }
    }
  ],
